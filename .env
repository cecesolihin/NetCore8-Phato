# Email Configuration
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-security
JWT_ISSUER=ThePatho
JWT_AUDIENCE=ThePathoUsers
JWT_EXPIRATION_MINUTES=60

# API Configuration
API_BASE_URL=http://localhost:5286
FRONTEND_URL=http://localhost:3000

# Database Configuration (jika diperlukan)
DB_CONNECTION_STRING=Server=(localdb)\\MSSQLLocalDB;Database=DB_TRIAL_2;MultipleActiveResultSets=true;TrustServerCertificate=True

